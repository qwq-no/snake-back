        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="① 打开 WS 连接" enabled="true">
          <stringProp name="cacheKey">false</stringProp>
          <stringProp name="script">import java.net.URI
import java.net.http.HttpClient
import java.net.http.WebSocket
import java.util.concurrent.CompletableFuture
import java.util.concurrent.CompletionStage
import java.util.concurrent.TimeUnit

def host = vars.get(&quot;HOST&quot;)
def port = vars.get(&quot;PORT&quot;)
def wsUrl = &quot;ws://&quot; + host + &quot;:&quot; + port + &quot;/ws/game&quot;
def latch = new CompletableFuture()
def errorRef = new Object[1]

def listener = new WebSocket.Listener() {
    void onOpen(WebSocket w) {
        latch.complete(null)
        w.request(1)
    }
    CompletionStage onText(WebSocket w, CharSequence data, boolean last) {
        w.request(1)
        return null
    }
    void onError(WebSocket w, Throwable t) {
        errorRef[0] = t
        latch.complete(null)
    }
    CompletionStage onClose(WebSocket w, int code, String reason) {
        return null
    }
}

def client = props.get(&quot;sharedClient&quot;) as HttpClient
def ws = client.newWebSocketBuilder()
    .buildAsync(URI.create(wsUrl), listener)
    .get(5, TimeUnit.SECONDS)

latch.get(5, TimeUnit.SECONDS)
if (errorRef[0] != null) {
    throw new RuntimeException(&quot;WS handshake failed: &quot; + errorRef[0].getMessage())
}

props.put(&quot;ws_&quot; + ctx.getThreadNum(), ws)
SampleResult.setResponseCode(&quot;101&quot;)
SampleResult.setResponseMessage(&quot;connected&quot;)
SampleResult.setSuccessful(true)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="② 发送 connect (pageType=select)" enabled="true">
          <stringProp name="cacheKey">false</stringProp>
          <stringProp name="script">import java.util.concurrent.TimeUnit

def ws = props.get(&quot;ws_&quot; + ctx.getThreadNum())
def uc = vars.get(&quot;userCode&quot;)
def msg = &apos;{&quot;type&quot;:&quot;connect&quot;,&quot;pageType&quot;:&quot;select&quot;,&quot;userCode&quot;:&quot;&apos; + uc + &apos;&quot;}&apos;
ws.sendText(msg, true).get(3, TimeUnit.SECONDS)
SampleResult.setResponseCode(&quot;200&quot;)
SampleResult.setResponseMessage(&quot;connected as &quot; + uc)
SampleResult.setSuccessful(true)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="③ Join 房间" enabled="true">
          <stringProp name="cacheKey">false</stringProp>
          <stringProp name="script">import java.util.concurrent.TimeUnit

def ws = props.get(&quot;ws_&quot; + ctx.getThreadNum())
def roomCount = (vars.get(&quot;ROOM_COUNT&quot;) as int)
def roomCode = (ctx.getThreadNum() % roomCount) + 1
def msg = &apos;{&quot;type&quot;:&quot;join&quot;,&quot;pageType&quot;:&quot;select&quot;,&quot;roomCode&quot;:&apos; + roomCode + &apos;}&apos;
ws.sendText(msg, true).get(3, TimeUnit.SECONDS)
vars.put(&quot;roomCode&quot;, String.valueOf(roomCode))
SampleResult.setResponseCode(&quot;200&quot;)
SampleResult.setResponseMessage(&quot;joined room &quot; + roomCode)
SampleResult.setSuccessful(true)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="④ page_change → prepare" enabled="true">
          <stringProp name="cacheKey">false</stringProp>
          <stringProp name="script">import java.util.concurrent.TimeUnit

def ws = props.get(&quot;ws_&quot; + ctx.getThreadNum())
def rc = vars.get(&quot;roomCode&quot;)
def msg = &apos;{&quot;type&quot;:&quot;page_change&quot;,&quot;pageType&quot;:&quot;prepare&quot;,&quot;roomCode&quot;:&apos; + rc + &apos;}&apos;
ws.sendText(msg, true).get(3, TimeUnit.SECONDS)
SampleResult.setResponseCode(&quot;200&quot;)
SampleResult.setResponseMessage(&quot;page=prepare room=&quot; + rc)
SampleResult.setSuccessful(true)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="⑤ Barrier（房间 + 全局同步）" enabled="true">
          <stringProp name="cacheKey">false</stringProp>
          <stringProp name="script">def rc = vars.get(&quot;roomCode&quot;)
def playersPerRoom = (vars.get(&quot;PLAYERS_PER_ROOM&quot;) as int)

// 房间级 barrier：等待本房间满员
def key = &quot;room_chat_ready_&quot; + rc
synchronized (props) {
    def cur = (props.get(key) ?: 0) as int
    cur++
    props.put(key, cur)
}

def start = System.currentTimeMillis()
while (true) {
    def cur = (props.get(key) ?: 0) as int
    if (cur &gt;= playersPerRoom) break
    if (System.currentTimeMillis() - start &gt; 60000) {
        SampleResult.setSuccessful(false)
        SampleResult.setResponseMessage(&quot;room barrier timeout: &quot; + cur + &quot;/&quot; + playersPerRoom)
        throw new RuntimeException(&quot;room barrier timeout&quot;)
    }
    Thread.sleep(100)
}

// 房间就绪标记
synchronized (props) {
    def roomDone = (props.get(&quot;chat_room_barrier_done_&quot; + rc) ?: false)
    if (!roomDone) {
        props.put(&quot;chat_room_barrier_done_&quot; + rc, true)
        def globalRooms = (props.get(&quot;chat_global_rooms_ready&quot;) ?: 0) as int
        globalRooms++
        props.put(&quot;chat_global_rooms_ready&quot;, globalRooms)
    }
}

// 全局 barrier：等待所有房间就绪
def roomCount = (vars.get(&quot;ROOM_COUNT&quot;) as int)
def globalBarrierStart = System.currentTimeMillis()
while (true) {
    def globalRooms = (props.get(&quot;chat_global_rooms_ready&quot;) ?: 0) as int
    if (globalRooms &gt;= roomCount) break
    if (System.currentTimeMillis() - globalBarrierStart &gt; 60000) {
        SampleResult.setSuccessful(false)
        SampleResult.setResponseMessage(&quot;global barrier timeout: &quot; + globalRooms + &quot;/&quot; + roomCount)
        throw new RuntimeException(&quot;global barrier timeout&quot;)
    }
    Thread.sleep(100)
}

// 统一开始时间
synchronized (props) {
    if (props.get(&quot;chat_start_time&quot;) == null) {
        props.put(&quot;chat_start_time&quot;, System.currentTimeMillis())
    }
}

SampleResult.setResponseCode(&quot;200&quot;)
SampleResult.setResponseMessage(&quot;barrier passed room=&quot; + rc)
SampleResult.setSuccessful(true)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree/>
        <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="聊天循环（直到超时）" enabled="true">
          <stringProp name="WhileController.condition">${__jexl3(vars.get(&quot;CHAT_OVER&quot;) == null)}</stringProp>
        </WhileController>
        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="⑥ 发送群聊消息 + 周期性心跳" enabled="true">
            <stringProp name="cacheKey">false</stringProp>
            <stringProp name="script">import java.util.concurrent.TimeUnit
import java.util.concurrent.atomic.AtomicInteger

def ws = props.get(&quot;ws_&quot; + ctx.getThreadNum())
if (ws == null || ws.isOutputClosed() || ws.isInputClosed()) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage(&quot;WS disconnected&quot;)
    vars.put(&quot;CHAT_OVER&quot;, &quot;true&quot;)
    return
}

// 超时检查
def startTime = props.get(&quot;chat_start_time&quot;)
def durationSec = (vars.get(&quot;DURATION_SEC&quot;) as int)
if (startTime != null) {
    def elapsed = (System.currentTimeMillis() - ((Long) startTime)) / 1000
    if (elapsed &gt; durationSec) {
        try { ws.sendText(&apos;{&quot;type&quot;:&quot;heartbeat&quot;}&apos;, true).get(500, TimeUnit.MILLISECONDS) } catch (Exception ignored) {}
        vars.put(&quot;CHAT_OVER&quot;, &quot;true&quot;)
        SampleResult.setSuccessful(true)
        SampleResult.setResponseMessage(&quot;DURATION_REACHED&quot;)
        return
    }
}

// 全局递增计数器 → 消息内容 &quot;1&quot;, &quot;2&quot;, &quot;3&quot;, ...
def counter = props.get(&quot;global_chat_counter&quot;) as AtomicInteger
def n = counter.getAndIncrement()
def content = String.valueOf(n)

// 每 5 条额外发一个 heartbeat 保活
if (n % 5 == 0) {
    try {
        ws.sendText(&apos;{&quot;type&quot;:&quot;heartbeat&quot;}&apos;, true).get(500, TimeUnit.MILLISECONDS)
    } catch (Exception ignored) {}
}

// 房间聊天消息 — 不传 pageType，server 从 session context 判断
def msg = &apos;{&quot;type&quot;:&quot;group_chat_send&quot;,&quot;content&quot;:&quot;&apos; + content + &apos;&quot;}&apos;
try {
    ws.sendText(msg, true).get(500, TimeUnit.MILLISECONDS)
    SampleResult.setSuccessful(true)
    SampleResult.setResponseMessage(&quot;sent #&quot; + content)
} catch (Exception e) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage(&quot;send timeout: &quot; + e.getMessage())
}</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
          </JSR223Sampler>
          <hashTree>
            <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="间隔 ${MSG_INTERVAL_MS}ms" enabled="true">
