        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="⑦ 离开房间 + 关闭 WS" enabled="true">
          <stringProp name="cacheKey">false</stringProp>
          <stringProp name="script">import java.util.concurrent.TimeUnit

def ws = props.remove(&quot;ws_&quot; + ctx.getThreadNum())
if (ws != null) {
    try {
        ws.sendText(&apos;{&quot;type&quot;:&quot;leave&quot;,&quot;pageType&quot;:&quot;prepare&quot;}&apos;, true).get(500, TimeUnit.MILLISECONDS)
    } catch (Exception ignored) {}
    try {
        ws.sendClose(1000, &quot;done&quot;).get(500, TimeUnit.MILLISECONDS)
    } catch (Exception ignored) {}
}
SampleResult.setResponseCode(&quot;200&quot;)
SampleResult.setResponseMessage(&quot;left + closed&quot;)
SampleResult.setSuccessful(true)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
