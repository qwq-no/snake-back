        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="① 打开 WS 连接" enabled="true">
          <stringProp name="cacheKey">false</stringProp>
          <stringProp name="script">import java.net.URI
import java.net.http.HttpClient
import java.net.http.WebSocket
import java.util.concurrent.CompletableFuture
import java.util.concurrent.CompletionStage
import java.util.concurrent.TimeUnit

def host = vars.get(&quot;HOST&quot;)
def port = vars.get(&quot;PORT&quot;)
def wsUrl = &quot;ws://&quot; + host + &quot;:&quot; + port + &quot;/ws/game&quot;
def latch = new CompletableFuture()
def errorRef = new Object[1]

def listener = new WebSocket.Listener() {
    void onOpen(WebSocket w) {
        latch.complete(null)
        w.request(1)
    }
    CompletionStage onText(WebSocket w, CharSequence data, boolean last) {
        w.request(1)
        return null
    }
    void onError(WebSocket w, Throwable t) {
        errorRef[0] = t
        latch.complete(null)
    }
    CompletionStage onClose(WebSocket w, int code, String reason) {
        return null
    }
}

def client = props.get(&quot;sharedClient&quot;) as HttpClient
def ws = client.newWebSocketBuilder()
    .buildAsync(URI.create(wsUrl), listener)
    .get(5, TimeUnit.SECONDS)

latch.get(5, TimeUnit.SECONDS)
if (errorRef[0] != null) {
    throw new RuntimeException(&quot;WS handshake failed: &quot; + errorRef[0].getMessage())
}

props.put(&quot;ws_&quot; + ctx.getThreadNum(), ws)
SampleResult.setResponseCode(&quot;101&quot;)
SampleResult.setResponseMessage(&quot;connected&quot;)
SampleResult.setSuccessful(true)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="② 发送 connect + 加入房间" enabled="true">
          <stringProp name="cacheKey">false</stringProp>
          <stringProp name="script">import java.util.concurrent.TimeUnit

def ws = props.get(&quot;ws_&quot; + ctx.getThreadNum())
def uc = vars.get(&quot;userCode&quot;)
def roomCount = (vars.get(&quot;ROOM_COUNT&quot;) as int)
def roomCode = (ctx.getThreadNum() % roomCount) + 1

// connect
ws.sendText(&apos;{&quot;type&quot;:&quot;connect&quot;,&quot;pageType&quot;:&quot;home&quot;,&quot;userCode&quot;:&quot;&apos; + uc + &apos;&quot;}&apos;, true).get(3, TimeUnit.SECONDS)

// join room（为 prepare 页面做准备）
ws.sendText(&apos;{&quot;type&quot;:&quot;join&quot;,&quot;pageType&quot;:&quot;select&quot;,&quot;roomCode&quot;:&apos; + roomCode + &apos;}&apos;, true).get(3, TimeUnit.SECONDS)

vars.put(&quot;roomCode&quot;, String.valueOf(roomCode))
SampleResult.setResponseCode(&quot;200&quot;)
SampleResult.setResponseMessage(&quot;connected as &quot; + uc + &quot;, room=&quot; + roomCode)
SampleResult.setSuccessful(true)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="③ 全局 Barrier" enabled="true">
          <stringProp name="cacheKey">false</stringProp>
          <stringProp name="script">synchronized (props) {
    def ready = (props.get(&quot;status_test_ready_count&quot;) ?: 0) as int
    ready++
    props.put(&quot;status_test_ready_count&quot;, ready)
}

def totalThreads = (vars.get(&quot;THREADS&quot;) as int)
def start = System.currentTimeMillis()
while (true) {
    def ready = (props.get(&quot;status_test_ready_count&quot;) ?: 0) as int
    if (ready &gt;= totalThreads) break
    if (System.currentTimeMillis() - start &gt; 120000) {
        SampleResult.setSuccessful(false)
        SampleResult.setResponseMessage(&quot;barrier timeout: &quot; + ready + &quot;/&quot; + totalThreads)
        throw new RuntimeException(&quot;barrier timeout&quot;)
    }
    Thread.sleep(100)
}

synchronized (props) {
    if (props.get(&quot;status_test_start_time&quot;) == null) {
        props.put(&quot;status_test_start_time&quot;, System.currentTimeMillis())
    }
}

SampleResult.setResponseCode(&quot;200&quot;)
SampleResult.setResponseMessage(&quot;barrier passed&quot;)
SampleResult.setSuccessful(true)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree/>
        <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="页面切换循环（直到超时）" enabled="true">
          <stringProp name="WhileController.condition">${__jexl3(vars.get(&quot;SWITCH_OVER&quot;) == null)}</stringProp>
        </WhileController>
        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="④ page_change 循环：home→select→prepare→select..." enabled="true">
            <stringProp name="cacheKey">false</stringProp>
            <stringProp name="script">import java.util.concurrent.TimeUnit

def ws = props.get(&quot;ws_&quot; + ctx.getThreadNum())
if (ws == null || ws.isOutputClosed() || ws.isInputClosed()) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage(&quot;WS disconnected&quot;)
    vars.put(&quot;SWITCH_OVER&quot;, &quot;true&quot;)
    return
}

// 超时检查
def startTime = props.get(&quot;status_test_start_time&quot;)
def durationSec = (vars.get(&quot;DURATION_SEC&quot;) as int)
if (startTime != null) {
    def elapsed = (System.currentTimeMillis() - ((Long) startTime)) / 1000
    if (elapsed &gt; durationSec) {
        try { ws.sendText(&apos;{&quot;type&quot;:&quot;heartbeat&quot;}&apos;, true).get(500, TimeUnit.MILLISECONDS) } catch (Exception ignored) {}
        vars.put(&quot;SWITCH_OVER&quot;, &quot;true&quot;)
        SampleResult.setSuccessful(true)
        SampleResult.setResponseMessage(&quot;DURATION_REACHED&quot;)
        return
    }
}

def rc = vars.get(&quot;roomCode&quot;)

// 循环切换: home → select → prepare → select → home → ...
def step = (props.get(&quot;switch_step_&quot; + ctx.getThreadNum()) ?: 0) as int
def pages = [
    [&apos;type&apos;: &apos;page_change&apos;, &apos;pageType&apos;: &apos;select&apos;],
    [&apos;type&apos;: &apos;page_change&apos;, &apos;pageType&apos;: &apos;prepare&apos;, &apos;roomCode&apos;: rc],
    [&apos;type&apos;: &apos;page_change&apos;, &apos;pageType&apos;: &apos;select&apos;],
    [&apos;type&apos;: &apos;page_change&apos;, &apos;pageType&apos;: &apos;home&apos;]
]

// 每 12 次切换（~3 轮）发一次 heartbeat
if (step % 12 == 0) {
    try { ws.sendText(&apos;{&quot;type&quot;:&quot;heartbeat&quot;}&apos;, true).get(500, TimeUnit.MILLISECONDS) } catch (Exception ignored) {}
}

def page = pages[step % pages.size()]
def json = new groovy.json.JsonBuilder(page).toString()

try {
    ws.sendText(json, true).get(500, TimeUnit.MILLISECONDS)
    step++
    props.put(&quot;switch_step_&quot; + ctx.getThreadNum(), step)
    SampleResult.setSuccessful(true)
    SampleResult.setResponseMessage(&quot;page=&quot; + page[&apos;pageType&apos;] + &quot; step=&quot; + step)
} catch (Exception e) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage(&quot;send timeout: &quot; + e.getMessage())
}</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
          </JSR223Sampler>
          <hashTree>
            <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="间隔 ${PAGE_SWITCH_MS}ms" enabled="true">
