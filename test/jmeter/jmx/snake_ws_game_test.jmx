        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="① 打开 WS 连接" enabled="true">
          <stringProp name="cacheKey">false</stringProp>
          <stringProp name="script">import java.net.URI
import java.net.http.HttpClient
import java.net.http.WebSocket
import java.util.concurrent.CompletableFuture
import java.util.concurrent.CompletionStage
import java.util.concurrent.TimeUnit

def host = vars.get(&quot;HOST&quot;)
def port = vars.get(&quot;PORT&quot;)
def wsUrl = &quot;ws://&quot; + host + &quot;:&quot; + port + &quot;/ws/game&quot;
def latch = new CompletableFuture()
def errorRef = new Object[1]

def listener = new WebSocket.Listener() {
    void onOpen(WebSocket w) {
        latch.complete(null)
        w.request(1)
    }
    CompletionStage onText(WebSocket w, CharSequence data, boolean last) {
        w.request(1)
        return null
    }
    void onError(WebSocket w, Throwable t) {
        errorRef[0] = t
        latch.complete(null)
    }
    CompletionStage onClose(WebSocket w, int code, String reason) {
        return null
    }
}

def client = props.get(&quot;sharedClient&quot;) as HttpClient
def ws = client.newWebSocketBuilder()
    .buildAsync(URI.create(wsUrl), listener)
    .get(5, TimeUnit.SECONDS)

latch.get(5, TimeUnit.SECONDS)
if (errorRef[0] != null) {
    throw new RuntimeException(&quot;WS handshake failed: &quot; + errorRef[0].getMessage())
}

props.put(&quot;ws_&quot; + ctx.getThreadNum(), ws)
SampleResult.setResponseCode(&quot;101&quot;)
SampleResult.setResponseMessage(&quot;connected&quot;)
SampleResult.setSuccessful(true)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="② 发送 connect" enabled="true">
          <stringProp name="cacheKey">false</stringProp>
          <stringProp name="script">import java.util.concurrent.TimeUnit

def ws = props.get(&quot;ws_&quot; + ctx.getThreadNum())
def uc = vars.get(&quot;userCode&quot;)
def msg = &apos;{&quot;type&quot;:&quot;connect&quot;,&quot;pageType&quot;:&quot;select&quot;,&quot;userCode&quot;:&quot;&apos; + uc + &apos;&quot;}&apos;
ws.sendText(msg, true).get(3, TimeUnit.SECONDS)
SampleResult.setResponseCode(&quot;200&quot;)
SampleResult.setResponseMessage(&quot;connected as &quot; + uc)
SampleResult.setSuccessful(true)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="③ Join 房间" enabled="true">
          <stringProp name="cacheKey">false</stringProp>
          <stringProp name="script">import java.util.concurrent.TimeUnit

def ws = props.get(&quot;ws_&quot; + ctx.getThreadNum())
def roomCount = (vars.get(&quot;ROOM_COUNT&quot;) as int)
def roomCode = (ctx.getThreadNum() % roomCount) + 1
def msg = &apos;{&quot;type&quot;:&quot;join&quot;,&quot;pageType&quot;:&quot;select&quot;,&quot;roomCode&quot;:&apos; + roomCode + &apos;}&apos;
ws.sendText(msg, true).get(3, TimeUnit.SECONDS)
vars.put(&quot;roomCode&quot;, String.valueOf(roomCode))
SampleResult.setResponseCode(&quot;200&quot;)
SampleResult.setResponseMessage(&quot;joined room &quot; + roomCode)
SampleResult.setSuccessful(true)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="④ page_change → prepare" enabled="true">
          <stringProp name="cacheKey">false</stringProp>
          <stringProp name="script">import java.util.concurrent.TimeUnit

def ws = props.get(&quot;ws_&quot; + ctx.getThreadNum())
def rc = vars.get(&quot;roomCode&quot;)
def msg = &apos;{&quot;type&quot;:&quot;page_change&quot;,&quot;pageType&quot;:&quot;prepare&quot;,&quot;roomCode&quot;:&apos; + rc + &apos;}&apos;
ws.sendText(msg, true).get(3, TimeUnit.SECONDS)
SampleResult.setResponseCode(&quot;200&quot;)
SampleResult.setResponseMessage(&quot;page=prepare room=&quot; + rc)
SampleResult.setSuccessful(true)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="⑤ 同步等待（Barrier）" enabled="true">
          <stringProp name="cacheKey">false</stringProp>
          <stringProp name="script">def rc = vars.get(&quot;roomCode&quot;)
def playersPerRoom = (vars.get(&quot;PLAYERS_PER_ROOM&quot;) as int)

def key = &quot;room_ready_&quot; + rc
synchronized (props) {
    def cur = (props.get(key) ?: 0) as int
    cur++
    props.put(key, cur)
}

def start = System.currentTimeMillis()
while (true) {
    def cur = (props.get(key) ?: 0) as int
    if (cur &gt;= playersPerRoom) break
    if (System.currentTimeMillis() - start &gt; 60000) {
        SampleResult.setSuccessful(false)
        SampleResult.setResponseMessage(&quot;barrier timeout: &quot; + cur + &quot;/&quot; + playersPerRoom)
        throw new RuntimeException(&quot;barrier timeout&quot;)
    }
    Thread.sleep(100)
}

// ① 房间就绪标记（每个房间只有第一个到达的线程递增全局房间计数）
synchronized (props) {
    def roomDone = (props.get(&quot;room_barrier_done_&quot; + rc) ?: false)
    if (!roomDone) {
        props.put(&quot;room_barrier_done_&quot; + rc, true)
        def globalRooms = (props.get(&quot;global_rooms_ready&quot;) ?: 0) as int
        globalRooms++
        props.put(&quot;global_rooms_ready&quot;, globalRooms)
    }
}

// ② 全局 barrier：等待所有房间就绪
def roomCount = (vars.get(&quot;ROOM_COUNT&quot;) as int)
def globalBarrierStart = System.currentTimeMillis()
while (true) {
    def globalRooms = (props.get(&quot;global_rooms_ready&quot;) ?: 0) as int
    if (globalRooms &gt;= roomCount) break
    if (System.currentTimeMillis() - globalBarrierStart &gt; 60000) {
        SampleResult.setSuccessful(false)
        SampleResult.setResponseMessage(&quot;global barrier timeout: &quot; + globalRooms + &quot;/&quot; + roomCount)
        throw new RuntimeException(&quot;global barrier timeout&quot;)
    }
    Thread.sleep(100)
}

// ③ 统一的游戏开始时间（全局唯一，所有线程共享）
synchronized (props) {
    def globalStarted = (props.get(&quot;game_started_global&quot;) ?: false)
    if (!globalStarted) {
        props.put(&quot;game_started_global&quot;, true)
        props.put(&quot;game_start_time_global&quot;, System.currentTimeMillis())
    }
}

SampleResult.setResponseCode(&quot;200&quot;)
SampleResult.setResponseMessage(&quot;barrier passed room=&quot; + rc)
SampleResult.setSuccessful(true)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="⑥ 发送 ready" enabled="true">
          <stringProp name="cacheKey">false</stringProp>
          <stringProp name="script">import java.util.concurrent.TimeUnit

def ws = props.get(&quot;ws_&quot; + ctx.getThreadNum())
ws.sendText(&apos;{&quot;type&quot;:&quot;ready&quot;,&quot;pageType&quot;:&quot;prepare&quot;}&apos;, true).get(3, TimeUnit.SECONDS)
SampleResult.setResponseCode(&quot;200&quot;)
SampleResult.setResponseMessage(&quot;ready&quot;)
SampleResult.setSuccessful(true)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="⑦ page_change → online" enabled="true">
          <stringProp name="cacheKey">false</stringProp>
          <stringProp name="script">import java.util.concurrent.TimeUnit

def ws = props.get(&quot;ws_&quot; + ctx.getThreadNum())
def rc = vars.get(&quot;roomCode&quot;)
def msg = &apos;{&quot;type&quot;:&quot;page_change&quot;,&quot;pageType&quot;:&quot;online&quot;,&quot;roomCode&quot;:&apos; + rc + &apos;}&apos;
ws.sendText(msg, true).get(3, TimeUnit.SECONDS)
SampleResult.setResponseCode(&quot;200&quot;)
SampleResult.setResponseMessage(&quot;page=online room=&quot; + rc)
SampleResult.setSuccessful(true)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree/>
        <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="输入循环（直到超时）" enabled="true">
          <stringProp name="WhileController.condition">${__jexl3(vars.get(&quot;GAME_OVER&quot;) == null)}</stringProp>
        </WhileController>
        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="⑧a 发送 input + 周期性 heartbeat" enabled="true">
            <stringProp name="cacheKey">false</stringProp>
            <stringProp name="script">import java.util.concurrent.TimeUnit

def ws = props.get(&quot;ws_&quot; + ctx.getThreadNum())
if (ws == null || ws.isOutputClosed() || ws.isInputClosed()) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage(&quot;WS disconnected&quot;)
    return
}

// 时间检查
def rc = vars.get(&quot;roomCode&quot;)
def startTime = props.get(&quot;game_start_time_global&quot;)
def durationSec = (vars.get(&quot;DURATION_SEC&quot;) as int)
if (startTime != null) {
    def elapsed = (System.currentTimeMillis() - ((Long) startTime)) / 1000
    if (elapsed &gt; durationSec) {
        try { ws.sendText(&apos;{&quot;type&quot;:&quot;heartbeat&quot;}&apos;, true).get(500, TimeUnit.MILLISECONDS) } catch (Exception ignored) {}
        vars.put(&quot;GAME_OVER&quot;, &quot;true&quot;)
        SampleResult.setSuccessful(true)
        SampleResult.setResponseMessage(&quot;GAME_DURATION_REACHED&quot;)
        return
    }
}

// 方向循环：w→a→s→d
def dirs = [&quot;w&quot;, &quot;a&quot;, &quot;s&quot;, &quot;d&quot;]
def cnt = (props.get(&quot;input_count_&quot; + ctx.getThreadNum()) ?: 0) as int
def idx = (ctx.getThreadNum() + cnt) % 4
def key = dirs[idx]

cnt++
props.put(&quot;input_count_&quot; + ctx.getThreadNum(), cnt)

// 每 3 次（约 450ms）额外发一个 heartbeat 保活，防止开局积压时超时
if (cnt % 3 == 0) {
    ws.sendText(&apos;{&quot;type&quot;:&quot;heartbeat&quot;}&apos;, true).get(500, TimeUnit.MILLISECONDS)
}

def msg = &apos;{&quot;type&quot;:&quot;input&quot;,&quot;pageType&quot;:&quot;online&quot;,&quot;key&quot;:&quot;&apos; + key + &apos;&quot;}&apos;
ws.sendText(msg, true).get(500, TimeUnit.MILLISECONDS)
SampleResult.setResponseCode(&quot;200&quot;)
SampleResult.setResponseMessage(&quot;input &quot; + key + &quot; #&quot; + cnt)
SampleResult.setSuccessful(true)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
          </JSR223Sampler>
          <hashTree>
            <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="间隔 100ms（比 tick 快，保证方向队列不空）" enabled="true">
              <stringProp name="ConstantTimer.delay">100</stringProp>
            </ConstantTimer>
            <hashTree/>
          </hashTree>
